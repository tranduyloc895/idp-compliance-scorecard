# ============================================================
#  Backstage IDP Portal — Environment Variables Template
#  1. Copy this file:  cp .env.example .env
#  2. Fill in all values before running docker compose up -d
# ============================================================

# ── EC2 / Networking ────────────────────────────────────────
# Public IP (Elastic IP) of the EC2 instance running Backstage.
# Get this from:  terraform output elastic_ip
BACKSTAGE_HOST=<elastic-ip>

# ── Database ────────────────────────────────────────────────
# Strong random password for PostgreSQL.
# Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=<random-password>

# ── GitHub Integration ──────────────────────────────────────
# Personal Access Token with repo + workflow scopes.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxx

# ── GitHub OAuth App ─────────────────────────────────────────
# Create at: https://github.com/settings/developers → "New OAuth App"
# Homepage URL:   http://<elastic-ip>:3000
# Callback URL:   http://<elastic-ip>:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=Iv1.xxx
AUTH_GITHUB_CLIENT_SECRET=xxx

# ── ArgoCD Integration ──────────────────────────────────────
# ArgoCD server URL (available after M1.3 EKS deploy).
# Example: https://argocd.example.com  or  http://<nlb-dns>
ARGOCD_URL=https://<argocd-server>

# ArgoCD API token (create via: argocd account generate-token)
ARGOCD_AUTH_TOKEN=xxx

# ArgoCD admin password (used for health checks, optional)
ARGOCD_ADMIN_PASSWORD=
