# Compliance Engine — Environment Variables
# Copy this file to .env and fill in the values

# ============================================================
# PostgreSQL (Database)
# ============================================================
# For local dev: PostgreSQL runs on port 5433 (avoid conflict with Backstage port 5432)
# For EKS: Use the shared PostgreSQL pod, database 'compliance'
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance_dev_password
POSTGRES_DB=compliance

# ============================================================
# Redis (Cache)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Gemini AI (Required for AI recommendations)
# ============================================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Kubernetes
# ============================================================
# Leave empty to use default kubeconfig (~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig
# Set to "true" when running inside a Kubernetes Pod
K8S_IN_CLUSTER=false

# ============================================================
# Application Settings
# ============================================================
LOG_LEVEL=INFO
DEBUG=false
# Scan interval in seconds (default: 30 minutes)
SCAN_INTERVAL_SECONDS=1800
